<Window x:Class="HomeworkGate.App.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка..." Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{StaticResource BrBgDeep}">
    <StackPanel VerticalAlignment="Center" Margin="32">
        <TextBlock Text="🤖 AI проверяет решение" FontFamily="Segoe UI"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource BrTextPrimary}"
                   TextAlignment="Center" Margin="0,0,0,12"/>
        <ProgressBar IsIndeterminate="True" Height="4"
                     Foreground="{StaticResource BrAccentGreen}"
                     Background="{StaticResource BrBgCard}"
                     BorderThickness="0" Margin="0,0,0,12"/>
        <TextBlock x:Name="StatusText"
                   Text="Отправляю запрос..."
                   FontFamily="Segoe UI" FontSize="12"
                   Foreground="{StaticResource BrTextSecondary}"
                   TextAlignment="Center"/>
    </StackPanel>
</Window>
